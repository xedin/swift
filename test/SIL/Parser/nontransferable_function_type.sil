// RUN: %empty-directory(%t)
// RUN: %target-sil-opt -sil-print-types -enable-sil-verify-all=true %s | %FileCheck %s
// RUN: %target-sil-opt -sil-print-types %s -emit-sib -o %t/tmp.sib -module-name nontransferable_function_type
// RUN: %target-sil-opt -sil-print-types %t/tmp.sib -module-name nontransferable_function_type | %FileCheck %s --check-prefix=SIB

// SIB-DAG: sil @nontransferable_thin_callee : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
// SIB-DAG: sil [ossa] @take_nontransferable : $@convention(thin) (@guaranteed @nontransferable @callee_guaranteed () -> ()) -> () {
// SIB-DAG: convert_function {{%.*}} : $@callee_guaranteed () -> () to $@nontransferable @callee_guaranteed () -> ()
// SIB-DAG: partial_apply [callee_guaranteed] {{%.*}}({{%.*}}) : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
// SIB-DAG: sil [ossa] @take_nontransferable_async : $@convention(thin) (@guaranteed @nontransferable @async @callee_guaranteed () -> ()) -> ()

sil_stage canonical

import Builtin
import Swift

sil @thin_callee : $@convention(thin) () -> ()
sil @nontransferable_thin_callee : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()

// CHECK-LABEL: sil [ossa] @take_nontransferable : $@convention(thin) (@guaranteed @nontransferable @callee_guaranteed () -> ()) -> () {
// CHECK: bb0(%0 : @guaranteed $@nontransferable @callee_guaranteed () -> ()):
// CHECK: } // end sil function 'take_nontransferable'
sil [ossa] @take_nontransferable : $@convention(thin) (@guaranteed @nontransferable @callee_guaranteed () -> ()) -> () {
bb0(%0 : @guaranteed $@nontransferable @callee_guaranteed () -> ()):
  %1 = tuple ()
  return %1 : $()
}

// CHECK-LABEL: sil [ossa] @convert_to_nontransferable : $@convention(thin) () -> @owned @nontransferable @callee_guaranteed () -> () {
// CHECK:   [[F:%.*]] = function_ref @thin_callee : $@convention(thin) () -> ()
// CHECK:   [[PA:%.*]] = partial_apply [callee_guaranteed] [[F]]() : $@convention(thin) () -> ()
// CHECK:   [[R:%.*]] = convert_function [[PA]] : $@callee_guaranteed () -> () to $@nontransferable @callee_guaranteed () -> ()
// CHECK:   return [[R]] : $@nontransferable @callee_guaranteed () -> ()
// CHECK: } // end sil function 'convert_to_nontransferable'
sil [ossa] @convert_to_nontransferable : $@convention(thin) () -> @owned @nontransferable @callee_guaranteed () -> () {
bb0:
  %f = function_ref @thin_callee : $@convention(thin) () -> ()
  %pa = partial_apply [callee_guaranteed] %f() : $@convention(thin) () -> ()
  %r = convert_function %pa : $@callee_guaranteed () -> () to $@nontransferable @callee_guaranteed () -> ()
  return %r : $@nontransferable @callee_guaranteed () -> ()
}

// CHECK-LABEL: sil [ossa] @partial_apply_nontransferable : $@convention(thin) (@owned Builtin.NativeObject) -> @owned @nontransferable @callee_guaranteed () -> () {
// CHECK: bb0([[ARG:%.*]] : @owned $Builtin.NativeObject):
// CHECK:   [[F:%.*]] = function_ref @nontransferable_thin_callee : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
// CHECK:   [[PA:%.*]] = partial_apply [callee_guaranteed] [[F]]([[ARG]]) : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
// CHECK:   return [[PA]] : $@nontransferable @callee_guaranteed () -> ()
// CHECK: } // end sil function 'partial_apply_nontransferable'
sil [ossa] @partial_apply_nontransferable : $@convention(thin) (@owned Builtin.NativeObject) -> @owned @nontransferable @callee_guaranteed () -> () {
bb0(%0 : @owned $Builtin.NativeObject):
  %f = function_ref @nontransferable_thin_callee : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
  %pa = partial_apply [callee_guaranteed] %f(%0) : $@convention(thin) @nontransferable (@guaranteed Builtin.NativeObject) -> ()
  return %pa : $@nontransferable @callee_guaranteed () -> ()
}

// CHECK-LABEL: sil [ossa] @take_nontransferable_async : $@convention(thin) (@guaranteed @nontransferable @async @callee_guaranteed () -> ()) -> ()
sil [ossa] @take_nontransferable_async : $@convention(thin) (@guaranteed @nontransferable @async @callee_guaranteed () -> ()) -> () {
bb0(%0 : @guaranteed $@nontransferable @async @callee_guaranteed () -> ()):
  %1 = tuple ()
  return %1 : $()
}
